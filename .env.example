# Postgres
POSTGRES_DB=photocut
POSTGRES_USER=photocut
POSTGRES_PASSWORD=photocut

# Backend
APP_NAME=PhotoCut
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-strong-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+psycopg2://photocut:photocut@postgres:5432/photocut
REDIS_URL=redis://redis:6379/0
RQ_QUEUE=image_jobs
STORAGE_ROOT=/app/data
MAX_UPLOAD_SIZE_MB=15
API_KEY_PEPPER=replace-with-another-random-string
CORS_ORIGINS=http://localhost:3000

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000
